# Ripis — environment template.
#
DATABASE_URL="postgresql://ripis:CHANGE_ME_DB_PASSWORD@localhost:5433/ripis?schema=public"

# --- API --------------------------------------------------------------------
PORT="3000"

# --- Auth (ADR-0001: JWT access + refresh, Argon2id password hashing) -------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Admin seed (ADR-0013, ADR-0019) ----------------------------------------
# The admin is seeded from these values at first boot, and the password is
# hashed ONLY when the row is created (ADR-0019) — re-seeding must not re-hash.
# The admin is a person with their own ledger, not an operations account (§3).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"
