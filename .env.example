# Ripis — environment template.
#
# Local dev database: native PostgreSQL on port **5433** (no Docker), role `ripisapi`,
# database `ripisdb`. Two traps in that URL, and both fail silently:
#   1. A `?` in the password must be percent-encoded as `%3F`. Unencoded, it opens the
#      query string and the password is quietly truncated at that character.
#   2. Unquoted Postgres identifiers fold to lowercase, but a URL *username* is matched
#      exactly — `RipisAPI` in the URL is not the role `ripisapi` in the cluster.
# `ripisapi` needs CREATEDB for `prisma migrate dev` (it creates a shadow database).
# Run the Prisma CLI from the **repo root**, e.g.
#   npx prisma migrate dev --schema apps/api/prisma/schema.prisma
# That is the directory whose `.env` the CLI reads. Run from `apps/api` it finds no `.env` at
# all and stops with a bare "Environment variable not found: DATABASE_URL".
DATABASE_URL="postgresql://ripisapi:CHANGE_ME_DB_PASSWORD@localhost:5433/ripisdb?schema=public"

# --- API --------------------------------------------------------------------
PORT="3000"

# --- Auth (ADR-0001: JWT access + refresh, Argon2id password hashing) -------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Admin seed (ADR-0013, ADR-0019) ----------------------------------------
# The admin is seeded from these values at first boot, and the password is
# hashed ONLY when the row is created (ADR-0019) — re-seeding must not re-hash.
# The admin is a person with their own ledger, not an operations account (§3).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"
