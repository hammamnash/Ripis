// Ripis — the Prisma schema.
//
// Phase 1 builds this file one task at a time; every model lands with its own migration
// (`prisma migrate`, never hand-run SQL — ADR-0012).
//
// ADR-0038 pins this file and the client to the Prisma 6.x line for V1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An ISO 4217 currency. `minor_unit` decides display rounding (ADR-0003): IDR and VND are
/// 0, USD is 2 — money is rounded once, at display, and never in the database.
model Currency {
  code       String @id
  name       String
  symbol     String
  minor_unit Int

  users   User[]
  wallets Wallet[]

  @@map("currency")
}

/// One account is one private ledger: every table is scoped to a user (ADR-0020). There is
/// deliberately no family, group or tenant entity.
model User {
  /// Prisma generates this uuid, not the database — raw SQL must supply `gen_random_uuid()`.
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  email               String   @unique
  password_hash       String
  role                Role     @default(user)
  primary_currency_id String
  timezone            String   @default("Asia/Jakarta")
  created_at          DateTime @default(now()) @db.Timestamptz

  primaryCurrency Currency @relation(fields: [primary_currency_id], references: [code])
  wallets         Wallet[]

  @@map("user")
}

/// `admin` is provisioned at first boot from `.env` and its password is hashed only when the
/// row is created (ADR-0013, ADR-0019). No self-signup, no invite links.
enum Role {
  admin
  user
}

/// A wallet holds money in exactly one currency. A liability balance is stored **positive** and
/// subtracted from net worth (ADR-0025): `value = is_liability ? -balance : +balance`, computed
/// once. Direction is never carried by the sign of `balance`.
model Wallet {
  id          String     @id @default(uuid()) @db.Uuid
  user_id     String     @db.Uuid
  name        String
  wallet_type WalletType
  /// Required, never inferred from the balance, and not re-derived from `wallet_type` after
  /// creation (ADR-0025) — only Investment Account and Other have no pre-fill.
  is_liability  Boolean
  currency_id   String
  /// Immutable after creation. `current_balance` is stored and recomputed in ONE place.
  opening_balance Decimal @db.Decimal(19, 4)
  current_balance Decimal @db.Decimal(19, 4)
  institution     String?
  notes           String?
  /// Archived to the side — NOT deleted. Distinct from `deleted_at`: an inactive wallet stays in
  /// history and out of pickers, a soft-deleted one leaves every list (`02-context.md` §3).
  active     Boolean   @default(true)
  deleted_at DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz

  user     User     @relation(fields: [user_id], references: [id])
  currency Currency @relation(fields: [currency_id], references: [code])

  @@index([user_id, deleted_at])
  @@map("wallet")
}

enum WalletType {
  cash
  debit_account
  savings_account
  checking_account
  prepaid_card
  e_wallet
  credit_card
  loan
  debt
  investment_account
  other
}
