{
  "name": "@ripis/api",
  "version": "0.0.0",
  "private": true,
  "description": "Ripis API — the service boundary. Money rules live here; screens ask for figures, they never compute them.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
