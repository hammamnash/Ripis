// Ripis — the Prisma schema.
//
// Phase 1 builds this file one task at a time; every model lands with its own migration
// (`prisma migrate`, never hand-run SQL — ADR-0012).
//
// ADR-0038 pins this file and the client to the Prisma 6.x line for V1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An ISO 4217 currency. `minor_unit` decides display rounding (ADR-0003): IDR and VND are
/// 0, USD is 2 — money is rounded once, at display, and never in the database.
model Currency {
  code       String @id
  name       String
  symbol     String
  minor_unit Int

  users   User[]
  wallets Wallet[]

  transactions      Transaction[] @relation("transaction_currency")
  base_transactions Transaction[] @relation("transaction_base_currency")

  @@map("currency")
}

/// One account is one private ledger: every table is scoped to a user (ADR-0020). There is
/// deliberately no family, group or tenant entity.
model User {
  /// Prisma generates this uuid, not the database — raw SQL must supply `gen_random_uuid()`.
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  email               String   @unique
  password_hash       String
  role                Role     @default(user)
  primary_currency_id String
  timezone            String   @default("Asia/Jakarta")
  created_at          DateTime @default(now()) @db.Timestamptz

  primaryCurrency Currency @relation(fields: [primary_currency_id], references: [code])
  wallets         Wallet[]
  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]

  @@map("user")
}

/// `admin` is provisioned at first boot from `.env` and its password is hashed only when the
/// row is created (ADR-0013, ADR-0019). No self-signup, no invite links.
enum Role {
  admin
  user
}

/// A wallet holds money in exactly one currency. A liability balance is stored **positive** and
/// subtracted from net worth (ADR-0025): `value = is_liability ? -balance : +balance`, computed
/// once. Direction is never carried by the sign of `balance`.
model Wallet {
  id          String     @id @default(uuid()) @db.Uuid
  user_id     String     @db.Uuid
  name        String
  wallet_type WalletType
  /// Required, never inferred from the balance, and not re-derived from `wallet_type` after
  /// creation (ADR-0025) — only Investment Account and Other have no pre-fill.
  is_liability  Boolean
  currency_id   String
  /// Immutable after creation. `current_balance` is stored and recomputed in ONE place.
  opening_balance Decimal @db.Decimal(19, 4)
  current_balance Decimal @db.Decimal(19, 4)
  institution     String?
  notes           String?
  /// Archived to the side — NOT deleted. Distinct from `deleted_at`: an inactive wallet stays in
  /// history and out of pickers, a soft-deleted one leaves every list (`02-context.md` §3).
  active     Boolean   @default(true)
  deleted_at DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz

  user     User     @relation(fields: [user_id], references: [id])
  currency Currency @relation(fields: [currency_id], references: [code])

  transactions          Transaction[] @relation("source")
  incoming_transactions Transaction[] @relation("destination")

  @@index([user_id, deleted_at])
  @@map("wallet")
}

enum WalletType {
  cash
  debit_account
  savings_account
  checking_account
  prepaid_card
  e_wallet
  credit_card
  loan
  debt
  investment_account
  other
}

/// A category is one level — no `parent_id`, no sub-category table (ADR-0014) — and it is
/// archived, never deleted: a transaction references its category for the transaction's whole
/// life. `color` is chosen by the user and never assigned by rank or palette position (ADR-0030).
model Category {
  id          String       @id @default(uuid()) @db.Uuid
  user_id     String       @db.Uuid
  name        String
  type        CategoryType
  color       String
  icon        String?
  archived_at DateTime?    @db.Timestamptz
  created_at  DateTime     @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])

  transactions Transaction[]
  budgets      Budget[]

  @@unique([user_id, name, type])
  @@map("category")
}

enum CategoryType {
  income
  expense
}

/// One row per event — a cross-currency transfer is ONE row, never two mirrored ones (ADR-0008).
/// `occurred_on` drives reporting and `recorded_at` is audit only (ADR-0007); direction is carried
/// by `transaction_type` and never by a negative amount (`02-context.md` §3).
///
/// The three amounts (ADR-0004): `amount` in the source wallet's currency, `destination_amount`
/// when the two wallets differ, and `base_amount` frozen at entry so a historical total never
/// moves. There is no `exchange_rate` column and there must never be one — a rate is arithmetic,
/// derived for display.
model Transaction {
  id                    String    @id @default(uuid()) @db.Uuid
  user_id               String    @db.Uuid
  transaction_type      TxType
  occurred_on           DateTime  @db.Date
  recorded_at           DateTime  @default(now()) @db.Timestamptz
  wallet_id             String    @db.Uuid
  destination_wallet_id String?   @db.Uuid
  category_id           String?   @db.Uuid
  amount                Decimal   @db.Decimal(19, 4)
  currency_id           String
  base_amount           Decimal   @db.Decimal(19, 4)
  /// Frozen with `base_amount`. Given a foreign key — unlike the plan's sketch — so a row cannot
  /// point at a currency code that does not exist.
  base_currency_id      String
  destination_amount    Decimal?  @db.Decimal(19, 4)
  description           String?
  notes                 String?
  /// Postgres `text[]`, GIN indexed at Task 1.8 (ADR-0021).
  tags                  String[]  @default([])
  merchant              String?
  location              String?
  project               String?
  receipt_number        String?
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @updatedAt @db.Timestamptz
  deleted_at            DateTime? @db.Timestamptz

  user          User      @relation(fields: [user_id], references: [id])
  wallet        Wallet    @relation("source", fields: [wallet_id], references: [id])
  destination   Wallet?   @relation("destination", fields: [destination_wallet_id], references: [id])
  category      Category? @relation(fields: [category_id], references: [id])
  currency      Currency  @relation("transaction_currency", fields: [currency_id], references: [code])
  base_currency Currency  @relation("transaction_base_currency", fields: [base_currency_id], references: [code])

  @@index([user_id, occurred_on(sort: Desc)])
  @@index([user_id, wallet_id, occurred_on])
  @@index([user_id, category_id, occurred_on])
  @@index([user_id, base_amount])
  /// Postgres `text[]` needs the array operator class, and only GIN can answer a tag containment
  /// filter (ADR-0021).
  @@index([tags(ops: ArrayOps)], type: Gin)
  /// FR-13 server-side search. Declared here rather than only in raw SQL: an index the schema does
  /// not know about is drift to `prisma migrate dev`, which will happily DROP it in the next
  /// migration it generates.
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "transaction_description_trgm")
  @@index([notes(ops: raw("gin_trgm_ops"))], type: Gin, map: "transaction_notes_trgm")
  @@map("transaction")
}

enum TxType {
  expense
  income
  transfer
  exchange
}

/// One budget per category per calendar month, in the user's PRIMARY currency (§10) — never in a
/// wallet's, so a budget total needs no conversion at read time.
model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  category_id String   @db.Uuid
  amount      Decimal  @db.Decimal(19, 4)
  /// A calendar month as a date, never a timestamp (ADR-0007).
  month       DateTime @db.Date
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  user     User     @relation(fields: [user_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])

  @@unique([user_id, category_id, month])
  @@map("budget")
}

/// Append-only: application code never edits or deletes a row here (§14). It carries NO foreign key
/// on purpose — an audit trail that vanished with the row it describes would be worse than useless
/// — and `entity_id` is NULL for an action that describes an act rather than a row (auth, export).
model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  user_id       String      @db.Uuid
  actor_user_id String      @db.Uuid
  entity_type   AuditEntity
  entity_id     String?     @db.Uuid
  action        AuditAction
  before_value  Json?
  after_value   Json?
  created_at    DateTime    @default(now()) @db.Timestamptz

  @@index([user_id, created_at(sort: Desc)])
  @@map("audit_log")
}

enum AuditEntity {
  transaction
  wallet
  budget
  category
  user
  auth
  export
}

enum AuditAction {
  created
  updated
  deleted
  restored
  archived
  exported
  signed_in
  auth_failed
  password_changed
}
